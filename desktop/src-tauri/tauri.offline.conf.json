{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACE-Step Studio",
  "version": "0.1.0",
  "identifier": "ai.acestep.studio",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui/app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ui/app run build",
    "frontendDist": "../../ui/app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ACE-Step Studio",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/offline"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ACE-Step Studio",
        "installerHooks": "nsis/hooks.nsh",
        "compression": "none"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
