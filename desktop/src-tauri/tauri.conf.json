{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FUNO",
  "version": "0.1.9",
  "identifier": "ai.acestep.studio",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui/app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ui/app run build",
    "frontendDist": "../../ui/app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FUNO",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "resources": [
      "resources/offline/python_embeded",
      "resources/offline/backend/acestep",
      "resources/offline/backend/examples",
      "resources/offline/backend/pyproject.toml",
      "../../acestep",
      "../../pyproject.toml"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}